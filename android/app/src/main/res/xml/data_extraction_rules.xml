<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup, no device-to-device transfer of models, catalogs or logs.
     The only thing worth exporting is the signed catalog, and it is shipped in
     the APK anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
